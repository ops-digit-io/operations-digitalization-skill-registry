    {
        "id": "26ab1604bd13435f",
        "type": "function",
        "z": "00f27c832c7b2d2e",
        "g": "ea74c9d0fe8b2810",
        "name": "filter uuids",
        "func": "// get flow variable\nconst uuids = [flow.get('datapointTotalPartCounter')]\n\n// filter for uuid\nconst results = msg.payload.plcPackets.filter(plcPacket => uuids.includes(plcPacket.uuid))\n\n\n// publish results\nmsg.payload = results\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 420,
        "wires": [
            [
                "03077e8cf89184f6"
            ]
        ],
        "info": "1. loop over msg.payload.plcPackets each\n2. skip if uuid (or other filters) does not match\n3. emit entire plcPackets if uuid matches"
