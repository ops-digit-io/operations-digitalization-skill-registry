                "79a87fb778354393"
            ]
        ]
    },
    {
        "id": "b59989100812f83f",
        "type": "split",
        "z": "7b7af74ecb758624",
        "g": "0204a0cb7b26d3b6",
        "name": "flatten PLCPacket Array",
        "splt": "\\n",
        "spltType": "str",
        "arraySplt": 1,
        "arraySpltType": "len",
        "stream": false,
        "addname": "",
        "x": 990,
        "y": 380,
        "wires": [
