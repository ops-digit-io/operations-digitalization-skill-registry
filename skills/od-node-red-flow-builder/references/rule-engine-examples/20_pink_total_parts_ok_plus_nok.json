                "bdb418e8904fc8dd"
            ]
        ]
    },
    {
        "id": "bdb418e8904fc8dd",
        "type": "function",
        "z": "7b7af74ecb758624",
        "g": "0204a0cb7b26d3b6",
        "name": "Convert sysTime (UTC timestamp)",
        "func": "var sysTime = msg.payload.sysTime\n\nconst seconds_epoch = Number(BigInt(sysTime) >> 32n) // keep only first four bytes (seconds since epoch = 1.1.1970)\nconst nanos = Number(BigInt(sysTime) & 0xFFFFFFFFn)  // keep only last four bytes\nconst millis = Math.round(nanos / 1e6)\nconst millis_epoch = seconds_epoch * 1000 + millis //this is UTC\n//const timestamp = new Date(millis_epoch) // this is most likely in UTC!\n\nmsg.payload.sysTime = millis_epoch\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1320,
        "y": 380,
        "wires": [
            [
                "351a1ffeac2e0c1d"
            ]
        ]
    },
