    {
        "id": "d98322dcc1e8d7fd",
        "type": "function",
        "z": "bee0ebb496366228",
        "g": "cfb9719f4c23a823",
        "name": "mapping of machine status",
        "func": "\nvar valuesetup = flow.get(\"valuesetup\");\nvar valuemachinefault = flow.get(\"valuemachinefault\");\nvar valuequalityfault = flow.get(\"valuequalityfault\");\nvar valueMachineState = flow.get(\"valueMachineState\");\nvar valueProductName = flow.get(\"valueProductName\");\nvar valueotherfault = flow.get(\"valueotherfault\");\n\n// var preProName = flow.get('preProName') || null;//previous productname\n// var currProName = flow.get('currProName') || null;//current productname\n// var ProInfo =flow.get('ProInfo')||{};//store productname information\n\n\nif (valueMachineState === \"1\"){\n\n     msg.payload.valueString = \"Running\"\n     return msg\n } \n \nelse if (valueMachineState === \"0\" && valuemachinefault === \"0\" && valuequalityfault === \"0\" && valueotherfault !== \"0\" && valuesetup === \"0\") {\n     msg.payload.valueString = \"Others\"\n    return msg\n }\n\nelse if (valueMachineState === \"0\" && valuemachinefault === \"0\" && valuequalityfault !== \"0\" && valueotherfault === \"0\" && valuesetup === \"0\") {\n    msg.payload.valueString = \"Quality\"\n    return msg\n\n}\n\nelse if (valueMachineState === \"0\" && valuemachinefault !== \"0\" && valuequalityfault === \"0\" && valueotherfault === \"0\" && valuesetup === \"0\") {\n    msg.payload.valueString = \"Equipment\"\n    return msg\n\n}\n\nelse if (valueMachineState === \"0\" && valuemachinefault === \"0\" && valuequalityfault === \"0\" && valueotherfault === \"0\" && valuesetup !== \"0\") {\n    msg.payload.valueString = \"Changeover\"\n    return msg\n\n}\n\n\nelse if (valueMachineState === \"0\" && valuemachinefault === \"0\" && valuequalityfault === \"0\" && valueotherfault === \"0\" && valuesetup === \"0\") {\n    msg.payload.valueString = \"Idle\"\n    return msg\n\n}\n// if (valuequalityfault === \"-1\"){\n\n//     msg.payload.valueString = \"Quality\"\n//     return msg\n// }\n\n\n// if (valueotherfault === \"-1\" ){\n\n//     msg.payload.valueString = \"Others\"\n//     return msg\n// }\n\n\n// if (valuesetup === \"-1\"){\n\n//     msg.payload.valueString = \"Changeover\"\n//     return msg\n// }           \n\n\n\n\n// var ProNameChanged = false;\n// /*if(valueMachineIsReleased === true){\n//     msg.payload.valueString = \"Planned Loading Time\"\n//     return msg\n// }*/\n// if (valueMachineIsReleased === 0) {\n//     msg.payload.valueString = \"Planned Downtime\"\n//     flow.set(\"preProName\", null);\n//     return msg\n// }\n\n// else if (valueMachineIsReleased === -1 && valueMachineState === 1 && valueMachineMode === 1) {\n//     msg.payload.valueString = \"Normal Operating\"\n//     flow.set(\"preProName\", null);\n//     return msg\n// }\n// else if (valueMachineIsReleased === -1 && valueMachineState === 2) {\n//     msg.payload.valueString = \"Breakdown\"\n//     return msg\n// }\n// else if (valueMachineIsReleased === -1 && valueMachineState === 0 && valueMachineSetup === -1) {\n\n//     if (preProName === null) {\n//         flow.set(\"preProName\", valueProductName);\n//         msg.payload.valueString = \"Setup-ChangeYarn\"\n//         return msg\n//     }\n//     else {\n//         flow.set(\"currProName\", valueProductName);\n//         if (preProName !== currProName) {\n//             ProNameChanged = true;\n//             msg.payload.valueString = \"Setup-ChangeOver\"\n//             return msg\n//         }\n//         else {\n//             msg.payload.valueString = \"Setup-ChangeYarn\"\n//             return msg\n//         }\n//     }\n// }\n// else if (valueMachineIsReleased === -1 && valueMachineState === 1 && valueMachineMode === 0) {\n//     msg.payload.valueString = \"Manual Operating\"\n//     flow.set(\"preProName\", null);\n//     return msg\n// }\n// else if (valueMachineIsReleased === -1 && valueMachineState === 0 && valueMachineMode === 1) {\n//     msg.payload.valueString = \"Planned Downtime\"\n//     flow.set(\"preProName\", null);\n//     return msg\n// }\n// else {\n//     msg.payload.valueString = \"Planned Loading Time\"\n//     flow.set(\"preProName\", null);\n//     return msg\n// }",
