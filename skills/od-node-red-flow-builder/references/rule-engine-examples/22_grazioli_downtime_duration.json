        "id": "6bbf73fdd38fceaa",
        "type": "function",
        "z": "4f3052c660d65a97",
        "g": "d470f86608b5c021",
        "name": "calculate timerange between cycle_start and cycle_end event ",
        "func": "var machine_stop_time = msg.payload.sysTimeStart;\nvar machine_start_time = msg.payload.sysTimeEnd;\n\nmsg.payload.down_time = ((machine_start_time - machine_stop_time) / 1000 )\n\nif(isNaN(msg.payload.down_time)) {\n  return null; \n}\n\nif(msg.payload.down_time < 0) {\n  return null; \n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 760,
        "wires": [
            [
                "630ccae059599cc8"
            ]
        ],
        "info": "# Calculate cycle_time\n\nCalculation of difference between cycle times in seconds from unix formatted timestamps of cycle_start and cycle_end event"
