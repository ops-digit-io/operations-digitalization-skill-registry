        "name": "create json payload",
        "func": "var uuid = flow.get('downtime')\nvar sysTime = msg.payload.sysTimeEnd\nvar valueDouble = msg.payload.down_time\n\n\nmsg.payload = \n{\n    uuid: uuid,\n    sysTime: sysTime,\n    valueDouble: valueDouble,\n    isDelta: true\n}\n\nreturn msg;",
