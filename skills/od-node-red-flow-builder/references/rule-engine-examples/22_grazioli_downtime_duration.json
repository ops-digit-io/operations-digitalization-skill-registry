    },
    {
        "id": "0b2597bc7722b9ce",
        "type": "function",
        "z": "4f3052c660d65a97",
        "g": "5f921015e3928c54",
        "name": "filter uuids",
        "func": "// get flow variable\nconst uuids = flow.get('datapointConfigFilter')\n\n// filter for uuid\nconst results = msg.payload.plcPackets.filter(plcPacket => uuids.includes(plcPacket.uuid))\n\n// publish results\nmsg.payload = results\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 810,
        "y": 400,
        "wires": [
            [
                "cfe49b800ec088b5"
            ]
        ],
        "info": "1. loop over msg.payload.plcPackets each\n2. skip if uuid (or other filters) does not match\n3. emit entire plcPackets if uuid matches"
    },
