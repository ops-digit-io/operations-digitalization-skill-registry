        ],
        "x": 1665,
        "y": 520,
        "wires": []
    },
    {
        "id": "c69cf475dfac3aeb",
        "type": "function",
        "z": "629fa02299718c62",
        "g": "29eb2b0702f7b346",
        "name": "filter uuids",
        "func": "// get flow variable\nconst uuids = [flow.get('datapointMachineStatus')]\n\n// filter for uuid\nconst results = msg.payload.plcPackets.filter(plcPacket => uuids.includes(plcPacket.uuid))\n\n// publish results\nmsg.payload = results\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 520,
        "wires": [
            [
                "3dfe93af28d98805"
            ]
        ],
        "info": "1. loop over msg.payload.plcPackets each\n2. skip if uuid (or other filters) does not match\n3. emit entire plcPackets if uuid matches"
    },
