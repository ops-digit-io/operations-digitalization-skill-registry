        "name": "Debug flow config",
        "func": "var flowKeys = { };\n\n\nvar payload = {\n    datatronName: flow.get('datatronName'),\n    datapointMachineStatus: flow.get('datapointMachineStatus'),\n    statusmessageConfig: flow.get('statusmessageConfig'),\n    datapointMachineStatusMapped: flow.get('datapointMachineStatusMapped')\n};\n\nreturn { \n    payload: payload,\n    debugInfo: \"Added flow configuration\"\n};\n",
