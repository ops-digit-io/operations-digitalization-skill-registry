      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_NAME}"
          },
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH this_w AS (\n  SELECT SUM(EXTRACT(EPOCH FROM (LEAST(COALESCE(di.end_time, NOW()), NOW())\n- GREATEST(di.start_time,            NOW() - INTERVAL '7 days')))) / 3600.0 AS h\n  FROM downtime_incidents di\n  WHERE di.is_archived = false\n  AND di.start_time   <  NOW()\n  AND COALESCE(di.end_time, NOW()) >= NOW() - INTERVAL '7 days'\n  AND di.account_id IN ($account)\n),\nprev_w AS (\n  SELECT SUM(EXTRACT(EPOCH FROM (LEAST(COALESCE(di.end_time, NOW()), NOW() - INTERVAL '7 days')\n- GREATEST(di.start_time,            NOW() - INTERVAL '14 days')))) / 3600.0 AS h\n  FROM downtime_incidents di\n  WHERE di.is_archived = false\n  AND di.start_time   <  NOW() - INTERVAL '7 days'\n  AND COALESCE(di.end_time, NOW()) >= NOW() - INTERVAL '14 days'\n  AND di.account_id IN ($account)\n)\nSELECT ROUND(CAST(COALESCE(this_w.h, 0) - COALESCE(prev_w.h, 0) AS NUMERIC), 1)\n  AS delta_hours\nFROM this_w, prev_w",
          "refId": "A",
          "select": [
