      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_NAME}"
          },
          "format": "time_series",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH days AS (\n  SELECT generate_series(\n    date_trunc('day', NOW() - INTERVAL '13 days'),\n    date_trunc('day', NOW()),\n    INTERVAL '1 day'\n  ) AS day\n),\nsamples AS (\n  SELECT\n    t.systime,\n    COALESCE(t.value_double, t.value_integer, CAST(t.value_bool AS INTEGER)) AS state,\n    LEAD(t.systime) OVER (PARTITION BY t.uuid ORDER BY t.systime) AS next_systime\n  FROM telemetry t\n  JOIN signal_metadata s ON s.uuid = t.uuid\n  JOIN machines m ON m.id = s.machine_id\n  WHERE s.name = 'machine_state'\n    AND m.account_id IN ($account)\n    AND m.is_ignored = false\n    AND t.systime >= NOW() - INTERVAL '14 days' - INTERVAL '1 hour'\n    AND t.is_delta IN ('t', 'f')\n)\nSELECT\n  d.day AS time,\n  COALESCE(ROUND(CAST(SUM(EXTRACT(EPOCH FROM (\n    LEAST(COALESCE(samples.next_systime, NOW()), d.day + INTERVAL '1 day')\n    - GREATEST(samples.systime, d.day)\n  ))) / 3600.0 AS NUMERIC), 1), 0) AS \"Stopped hours\"\nFROM days d\nLEFT JOIN samples\n  ON samples.state = 0\n  AND samples.systime < d.day + INTERVAL '1 day'\n  AND COALESCE(samples.next_systime, NOW()) >= d.day\nGROUP BY d.day\nORDER BY d.day",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "timeColumnType": "timestamptz",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
      ],
      "title": "Daily stopped hours \u2014 last 14 days",
      "type": "timeseries"
    }
