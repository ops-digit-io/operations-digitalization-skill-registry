      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_NAME}"
          },
          "format": "time_series",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH state_b AS (\n  SELECT $__timeGroup(systime, '5s') AS ts,\n         AVG(COALESCE(\n           CAST(value_double  AS NUMERIC),\n           CAST(value_integer AS NUMERIC),\n           CAST(CAST(value_bool AS INTEGER) AS NUMERIC)\n         )) AS val\n  FROM telemetry\n  WHERE $__timeFilter(systime)\n    AND uuid = (${state_signal:raw})\n    AND is_delta IN ('t', 'f')\n  GROUP BY 1\n),\ntemp_b AS (\n  SELECT $__timeGroup(systime, '5s') AS ts,\n         AVG(COALESCE(\n           CAST(value_double  AS NUMERIC),\n           CAST(value_integer AS NUMERIC),\n           CAST(CAST(value_bool AS INTEGER) AS NUMERIC)\n         )) AS val\n  FROM telemetry\n  WHERE $__timeFilter(systime)\n    AND uuid = (${temp_signal:raw})\n    AND is_delta IN ('t', 'f')\n  GROUP BY 1\n)\nSELECT\n  state_b.ts AS time,\n  state_b.val AS \"State\",\n  temp_b.val  AS \"Temperature\"\nFROM state_b\nLEFT JOIN temp_b ON temp_b.ts = state_b.ts\nORDER BY state_b.ts",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
