      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_NAME}"
          },
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH state_changes AS (\n  SELECT\n    systime,\n    COALESCE(value_double, value_integer, CAST(value_bool AS INTEGER)) AS state,\n    LEAD(systime) OVER (ORDER BY systime) AS next_systime\n  FROM telemetry\n  WHERE $__timeFilter(systime)\n    AND uuid = (${state_signal:raw})\n    AND is_delta IN ('t', 'f')\n),\ndurations AS (\n  SELECT\n    state,\n    SUM(EXTRACT(EPOCH FROM (\n      LEAST(COALESCE(next_systime, NOW()), $__timeTo()::timestamptz)\n      - GREATEST(systime,                    $__timeFrom()::timestamptz)\n    ))) / 60.0 AS minutes_in_state\n  FROM state_changes\n  WHERE systime < $__timeTo()::timestamptz\n    AND COALESCE(next_systime, NOW()) >= $__timeFrom()::timestamptz\n  GROUP BY state\n)\nSELECT\n  CASE state WHEN 1 THEN 'Running'\n             WHEN 0 THEN 'Stopped'\n             ELSE 'Other (' || CAST(state AS TEXT) || ')'\n  END AS \"State\",\n  ROUND(CAST(minutes_in_state AS NUMERIC), 1) AS \"Minutes\"\nFROM durations\nORDER BY minutes_in_state DESC",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "timeColumnType": "timestamptz",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
      ],
