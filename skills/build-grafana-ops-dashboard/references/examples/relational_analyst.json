          "format": "time_series",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH daily AS (\n  SELECT\n    date_trunc('day', di.start_time) AS day,\n    AVG(EXTRACT(EPOCH FROM (di.end_time - di.start_time))) / 60.0 AS mttr_min\n  FROM downtime_incidents di\n  LEFT JOIN downtime_reasons dr ON dr.id = di.reason_id\n  WHERE di.end_time IS NOT NULL\n    AND $__timeFilter(di.start_time)\n    AND di.machine_id IN ($machine)\n    AND di.account_id IN ($account)\n  GROUP BY 1\n)\nSELECT\n  day AS time,\n  AVG(mttr_min) OVER (ORDER BY day ROWS BETWEEN 6 PRECEDING AND CURRENT ROW)\n    AS \"MTTR 7d rolling [min]\"\nFROM daily\nORDER BY day",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "timeColumnType": "timestamptz",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
      ],
      "title": "[Analyst] Downtime \u2014 MTTR rolling 7-day",
