<?xml version="1.0" encoding="UTF-8"?>
<!-- Fictional example for skills/process-derivation: invented, not a company process. Copy it and replace the content. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_example" targetNamespace="https://example.invalid/process-derivation">
  <bpmn:collaboration id="Collaboration_example">
    <bpmn:participant id="Participant_plant" name="Plant" processRef="Process_downtime" />
  </bpmn:collaboration>
  <bpmn:process id="Process_downtime" name="Record downtime reason" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_operator" name="Line operator">
        <bpmn:flowNodeRef>Start_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_known</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_recorded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_lead" name="Shift lead">
        <bpmn:flowNodeRef>Task_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_wait</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_stop" name="Stop detected">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_select" name="Select reason on screen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_known" name="Reason known?" default="Flow_no">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer_wait" name="Shift end reached">
      <bpmn:incoming>Flow_no</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_assign" name="Assign reason">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_recorded" name="Reason recorded">
      <bpmn:incoming>Flow_yes</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_stop" targetRef="Task_select" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_select" targetRef="Gateway_known" />
    <bpmn:sequenceFlow id="Flow_yes" name="yes" sourceRef="Gateway_known" targetRef="End_recorded" />
    <bpmn:sequenceFlow id="Flow_no" name="no: nobody knows" sourceRef="Gateway_known" targetRef="Timer_wait" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Timer_wait" targetRef="Task_assign" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_assign" targetRef="End_recorded" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_example">
    <bpmndi:BPMNPlane id="Plane_example" bpmnElement="Collaboration_example">
      <bpmndi:BPMNShape id="Participant_plant_di" bpmnElement="Participant_plant" isHorizontal="true"><dc:Bounds x="0" y="0" width="900" height="360" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_operator_di" bpmnElement="Lane_operator" isHorizontal="true"><dc:Bounds x="30" y="0" width="870" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_lead_di" bpmnElement="Lane_lead" isHorizontal="true"><dc:Bounds x="30" y="180" width="870" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_stop_di" bpmnElement="Start_stop"><dc:Bounds x="82" y="72" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_select_di" bpmnElement="Task_select"><dc:Bounds x="170" y="50" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_known_di" bpmnElement="Gateway_known" isMarkerVisible="true"><dc:Bounds x="345" y="65" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="330" y="30" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_wait_di" bpmnElement="Timer_wait"><dc:Bounds x="352" y="252" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_assign_di" bpmnElement="Task_assign"><dc:Bounds x="470" y="230" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_recorded_di" bpmnElement="End_recorded"><dc:Bounds x="702" y="72" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="744" y="83" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="118" y="90" /><di:waypoint x="170" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="290" y="90" /><di:waypoint x="345" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_yes_di" bpmnElement="Flow_yes"><di:waypoint x="395" y="90" /><di:waypoint x="702" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_no_di" bpmnElement="Flow_no"><di:waypoint x="370" y="115" /><di:waypoint x="370" y="252" /><bpmndi:BPMNLabel><dc:Bounds x="262" y="128" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="388" y="270" /><di:waypoint x="470" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="590" y="270" /><di:waypoint x="720" y="270" /><di:waypoint x="720" y="108" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
