        "func": "var datapointMachineModeAutomaticValue = flow.get('datapointMachineModeAutomaticValue')\nvar datapointMachineModeDiagnosticValue = flow.get('datapointMachineModeDiagnosticValue')\nvar datapointMachineModeManualValue = flow.get('datapointMachineModeManualValue')\nvar datapointMachineModeSingleStepValue = flow.get('datapointMachineModeSingleStepValue')\nvar datapointMachineModeFaultValue = flow.get('datapointMachineModeFaultValue')\n\nif(datapointMachineModeAutomaticValue == true && datapointMachineModeManualValue == false && datapointMachineModeDiagnosticValue == false && datapointMachineModeSingleStepValue == false && datapointMachineModeFaultValue\t== false){\n    msg.payload.valueString = \"Automatic Mode\"    \n    return msg\n}\nif(datapointMachineModeAutomaticValue == false && datapointMachineModeManualValue == true && datapointMachineModeDiagnosticValue == false && datapointMachineModeSingleStepValue == false && datapointMachineModeFaultValue\t== false){\n    msg.payload.valueString = \"Manual Mode\"    \n    return msg\n}\nif(datapointMachineModeAutomaticValue == false && datapointMachineModeManualValue == false && datapointMachineModeDiagnosticValue == true && datapointMachineModeSingleStepValue == false && datapointMachineModeFaultValue\t== false){\n    msg.payload.valueString = \"Diagnostic Mode\"    \n    return msg\n}\nif(datapointMachineModeAutomaticValue == false && datapointMachineModeManualValue == false && datapointMachineModeDiagnosticValue == false && datapointMachineModeSingleStepValue == true && datapointMachineModeFaultValue\t== false){\n    msg.payload.valueString = \"Single Step Mode\"    \n    return msg\n}\nif(datapointMachineModeAutomaticValue == false && datapointMachineModeManualValue == false && datapointMachineModeDiagnosticValue == false && datapointMachineModeSingleStepValue == false && datapointMachineModeFaultValue == true){\n    msg.payload.valueString = \"Fault Mode\"    \n    return msg\n}\nelse{\n    msg.payload.valueString = \"undefined\"\n    return msg\n}",
