    {
        "id": "a7022619b9cae90a",
        "type": "function",
        "z": "11fae8b8a00c2c6f",
        "g": "24d036df14512be5",
        "name": "filter uuids",
        "func": "// get flow variable\nconst uuids =   [flow.get('datapointMachineModeAutomatic'),flow.get('datapointMachineModeDiagnostic'),flow.get('datapointMachineModeManual'),\n                 flow.get('datapointMachineModeNormalized'),flow.get('datapointMachineModeSingleStep'),flow.get('datapointMachineModeFault')]\n\n// filter for uuid\nconst results = msg.payload.plcPackets.filter(plcPacket => uuids.includes(plcPacket.uuid))\n\n// publish results\nmsg.payload = results\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 420,
        "wires": [
            [
                "446c3280171c0e58"
            ]
        ],
        "info": "1. loop over msg.payload.plcPackets each\n2. skip if uuid (or other filters) does not match\n3. emit entire plcPackets if uuid matches"
    },
    {
        "id": "2bdb7133fb9fa0b6",
        "type": "function",
        "z": "11fae8b8a00c2c6f",
        "g": "24d036df14512be5",
        "name": "Convert sysTime (UTC timestamp)",
        "func": "var sysTime = msg.payload.sysTime\n\nconst seconds_epoch = Number(BigInt(sysTime) >> 32n) // keep only first four bytes (seconds since epoch = 1.1.1970)\nconst nanos = Number(BigInt(sysTime) & 0xFFFFFFFFn)  // keep only last four bytes\nconst millis = Math.round(nanos / 1e6)\nconst millis_epoch = seconds_epoch * 1000 + millis //this is UTC\n//const timestamp = new Date(millis_epoch) // this is most likely in UTC!\n\n\nmsg.payload.sysTime = millis_epoch\n\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1260,
