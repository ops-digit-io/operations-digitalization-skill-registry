    {
        "id": "28b436242d895cce",
        "type": "function",
        "z": "4dc5ef247d78d792",
        "g": "c1bbb26608d8af48",
        "name": "leak rate_now",
        "func": "// ------------------------------------\n// 0. 从 flow config 读取配置\n// ------------------------------------\nconst UUID_BASE = flow.get(\"datapointLeakBase\");\nconst UUID_INDEX = flow.get(\"datapointLeakIndex\");\nconst machineName = flow.get(\"machineName\");\n\nif (!UUID_BASE || !UUID_INDEX || !machineName) {\n    node.warn(\"Leak Rate flow config is missing\");\n    return null;\n}\n\n\n// ------------------------------------\n// 1. 输入是 PLCPacket Array\n// ------------------------------------\nconst packets = msg.payload;\n\nif (!Array.isArray(packets)) {\n    return null;\n}\n\n\n// ------------------------------------\n// 2. 找到 basenum 和 index\n// ------------------------------------\nlet basePacket = null;\nlet indexPacket = null;\n\nfor (const p of packets) {\n\n    if (p.uuid === UUID_BASE) {\n        basePacket = p;\n    }\n\n    if (p.uuid === UUID_INDEX) {\n        indexPacket = p;\n    }\n}\n\n\n// ------------------------------------\n// 3. 同一批必须两个点都有\n// ------------------------------------\nif (!basePacket || !indexPacket) {\n    return null;\n}\n\n\n// ------------------------------------\n// 4. 读取原始值\n// ------------------------------------\nconst baseRaw = Number(basePacket.valueInteger);\nconst index = Number(indexPacket.valueInteger);\n\nif (!Number.isFinite(baseRaw) ||\n    !Number.isFinite(index)) {\n    return null;\n}\n\n\n// ------------------------------------\n// 5. 实际底数 = 原始值 / 100\n// ------------------------------------\nconst baseReal = baseRaw / 100;\n\n\n// ------------------------------------\n// 6. Leakage Rate\n// ------------------------------------\nconst leakageRateRaw =\n    baseReal * Math.pow(10, index);\n\n// 尾数按2位处理，同时保持 Number 类型\nconst leakageRate =\n    Number(leakageRateRaw.toExponential(2));\n\n\n// ------------------------------------\n// 7. DATATRON sysTime → Unix ms\n// ------------------------------------\nlet sysTime = basePacket.sysTime;\n\nif (sysTime !== undefined && sysTime !== null) {\n\n    const t = BigInt(sysTime);\n\n    const seconds =\n        Number(t >> 32n);\n\n    const nanos =\n        Number(t & 0xFFFFFFFFn);\n\n    sysTime =\n        seconds * 1000 +\n        Math.round(nanos / 1e6);\n}\n\n\n// ------------------------------------\n// 8. 输出\n// ------------------------------------\nmsg.payload = {\n    machine: machineName,\n    basenum_raw: baseRaw,\n    basenum_real: baseReal,\n    index_now: index,\n    leakage_rate: leakageRate,\n    sysTime: sysTime\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
