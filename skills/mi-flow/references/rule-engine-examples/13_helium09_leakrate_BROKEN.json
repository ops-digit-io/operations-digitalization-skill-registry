        "name": "function 2",
        "func": "const UUID_BASE = flow.get(\"datapointLeakBase\");\nconst UUID_INDEX = flow.get(\"datapointLeakIndex\");\n\nconst packets = msg.payload;\n\nif (!Array.isArray(packets)) {\n    return null;\n}\n\nlet baseFound = null;\nlet indexFound = null;\n\nfor (const p of packets) {\n\n    if (p.uuid === UUID_BASE) {\n        baseFound = p;\n    }\n\n    if (p.uuid === UUID_INDEX) {\n        indexFound = p;\n    }\n}\n\nif (!baseFound && !indexFound) {\n    return null;\n}\n\nmsg.payload = {\n    baseFound: baseFound,\n    indexFound: indexFound\n};\n\nreturn msg;",
