    {
        "id": "301dcdd7e9602428",
        "type": "function",
        "z": "4dc5ef247d78d792",
        "name": "filter uuids",
        "func": "// Get flow variables\nconst datapoint1 = flow.get('datapointMachineState');\nconst datapoint2 = flow.get('datapointmachinefault');\nconst datapoint3 = flow.get('datapointqualityfault');\nconst datapoint4 = flow.get('datapointotherfault');\nconst datapoint5 = flow.get('datapointsetup');\nconst datapoint6 = flow.get('datapointMachineStatus');\nconst datapoint7 = flow.get('datapointProductName');\n\n// get flow variable\nconst uuids = [datapoint1, datapoint2, datapoint3, datapoint4, datapoint5, datapoint6, datapoint7];\n\n// filter for uuid\nconst results = msg.payload.plcPackets.filter(plcPacket => uuids.includes(plcPacket.uuid))\n\n\n// publish results\nmsg.payload = results\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1650,
        "y": 40,
        "wires": [
            []
        ],
        "info": "1. loop over msg.payload.plcPackets each\n2. skip if uuid (or other filters) does not match\n3. emit entire plcPackets if uuid matches"
    },
