        "name": "filter max value to get cycle time",
        "func": "let lastValue = context.get('lastValue') || 0.0;\nlet currentValue = msg.payload.valueDouble;\n\n// get the \nif (currentValue > lastValue) {\n    context.set('lastValue', currentValue);\n} else if (currentValue < lastValue) {\n    msg.payload.valueDouble = lastValue;\n    context.set('lastValue', 0.0);\n    return msg;\n}",
