  {
    "type": "function",
    "name": "Convert sysTime back (UTC timestamp)",
    "func": "const dt_new = new Date()\nconst dt = dt_new.getTime()\n\nconst in_left = Math.floor(dt/1000)\nconst nanos = BigInt(in_left) << 32n | BigInt(dt_new.getMilliseconds() * 1e6)\n\nmsg.payload.plcPackets[0].sysTime = Number(nanos)\nreturn msg;",
    "outputs": 1,
