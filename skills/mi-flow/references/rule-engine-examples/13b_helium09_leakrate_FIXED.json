  {
    "type": "function",
    "name": "filter uuids",
    "func": "// Get flow variables\nconst uuids = [\n    flow.get('datapointLeakBase'),\n    flow.get('datapointLeakIndex')\n];\n\n// filter for uuid\nconst results = msg.payload.plcPackets.filter(plcPacket => uuids.includes(plcPacket.uuid));\n\n// nothing relevant in this batch -> stop here\nif (results.length === 0) {\n    return null;\n}\n\nmsg.payload = results;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "1cebec42d077ba64"
      ]
    ],
    "info": "1. loop over msg.payload.plcPackets\n2. keep only leak base / leak index packets\n3. emit array of matching plcPackets",
