  {
    "type": "function",
    "name": "calculate leakage rate",
    "func": "// last known raw values, stored by the switch/change nodes above\nconst baseRaw = Number(flow.get('valueLeakBase'));\nconst index   = Number(flow.get('valueLeakIndex'));\n\n// wait until both datapoints have been seen at least once\nif (!Number.isFinite(baseRaw) || !Number.isFinite(index)) {\n    return null;\n}\n\n// real base = raw / 100 ; rate = base * 10^index\nconst baseReal = baseRaw / 100;\nconst leakageRate = Number((baseReal * Math.pow(10, index)).toExponential(2));\n\n// only publish when the value actually changes\nif (flow.get('lastLeakRate') === leakageRate) {\n    return null;\n}\nflow.set('lastLeakRate', leakageRate);\n\n// build a clean PLCPacket (uuid is set by the next node, sysTime is set on encode)\nmsg.payload = {\n    valueDouble: leakageRate   // <-- must match the float/double field name in plcschema.proto\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
