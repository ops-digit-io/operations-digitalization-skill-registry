%% OD New-State Service Lanes - process flow
%% Shapes: (( )) start/end event · { } gateway · [ ] task · [( )] catalog store
%% Colour used ONLY to flag the 5 net-new skill gaps (dashed orange). Skills shown as secondary line.
flowchart TD
    START((Request)) --> CLS{Classify<br/>demand}
    CLS -->|Known use case| L1G{Machine<br/>connected?}
    CLS -->|New UC, machine connected| C1
    CLS -->|New system / connector| D1

    %% ---------- LANE 1 : run a known use case (self-service) ----------
    subgraph LANE1 [Lane 1 - Run a known use case · self-service]
        direction TB
        L1G -->|Yes · 1a| A1["Pick from catalog<br/><i>catalog-usecase</i>"]
        A1 --> A2["Apply template<br/><i>od-analytics-asset-build</i>"]
        A2 --> A3["Validate and go live<br/><i>catalog-guardrails</i>"]
        A3 --> L1END(((Live)))

        L1G -->|No · 1b| B1["Pick UC + std system<br/><i>catalog-usecase, catalog-systems</i>"]
        B1 --> B2["Cost + approval ~d<br/><i>od-decision-routing</i>"]
        B2 --> B3["Order and connect ~wks<br/><i>od-equipment-integration</i>"]
        B3 --> B4["Apply template and go live<br/><i>od-analytics-asset-build</i>"]
        B4 --> L1END
    end

    %% ---------- LANE 2 : develop a new use case (OD-led) ----------
    subgraph LANE2 [Lane 2 - Develop a new use case · OD-led]
        direction TB
        C1["Define and diagnose<br/><i>od-use-case-definition</i>"] --> C2["Features + data check<br/><i>od-requirements-breakdown, od-data-availability-check</i>"]
        C2 --> G1{Value<br/>proven?}
        G1 -->|No| STOP1[Stop / rework]
        G1 -->|Yes| C3["Prototype / validate<br/><i>od-analytics-asset-build + PoC</i>"]
        C3 --> C4["Business case + rank<br/><i>od-benefit-calculation, bc-assessment</i>"]
        C4 --> G2{BC<br/>nameable?}
        G2 -->|No| STOP2[Refuse]
        G2 -->|Yes| C5["Capital request ~wks<br/><i>od-decision-routing</i>"]
        C5 --> C6["Implement and graduate<br/><i>od-handover-and-adoption</i>"]
        C6 --> G3{Repeatable?}
        G3 -->|No| L2END(((Done)))
        G3 -->|Yes| CAT[(Catalog)]
    end
    CAT -.->|graduates to| L1G

    %% ---------- LANE 3 : introduce a new system or connector ----------
    subgraph LANE3 [Lane 3 - New system or connector · OD / Ext / IT·CS]
        direction TB
        D1["Requirements<br/><i>od-requirements-breakdown</i>"] --> D2["Tool-decision / IT gate<br/><i>od-system-fit-check, od-decision-routing</i>"]
        D2 --> D3["Business case + capital ~wks<br/><i>od-benefit-calculation</i>"]
        D3 --> G4{System or<br/>connector?}

        G4 -->|3a · new system| E1["Package / build app<br/><i>it-demand-package</i>"]
        E1 --> E2["Deploy to platform + CS ~wks<br/><i>deploy-appstore</i>"]
        E2 --> E3["Rollout and adopt<br/><i>od-handover-and-adoption</i>"]
        E3 --> L3AEND(((Live)))

        G4 -->|3b · new connector| F1["Connector + pipeline to MDL<br/><i>od-equipment-integration, od-signal-standardization, od-node-red-flow-builder</i>"]
        F1 --> F2["Procure and connect ~wks<br/><i>od-equipment-integration</i>"]
        F2 --> F3["Acceptance + CS to live ~wks<br/><i>od-acceptance-test</i>"]
        F3 --> L3BEND(((On MDL)))
    end

    %% gap styling - the only net-new skills
    classDef gap fill:#ffffff,stroke:#f37558,stroke-width:2px,stroke-dasharray:5 4,color:#1b1e52;
    class A1,A3,B1,E1,E2 gap;

    %% event + gateway styling (minimal colour)
    classDef evt fill:#1b1e52,stroke:#1b1e52,color:#ffffff;
    class START,L1END,L2END,L3AEND,L3BEND evt;
    classDef gate fill:#fff7e6,stroke:#ffa500,color:#1b1e52;
    class CLS,L1G,G1,G2,G3,G4 gate;
